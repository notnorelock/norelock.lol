{
  "name": "norelock-lol",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "npx serve public",
    "build": "rm -rf dist && cp -r public dist && cp node_modules/hls.js/dist/hls.light.min.js dist/hls.js && node scripts/build-hls.mjs",
    "typecheck": "tsc --noEmit",
    "music": "node scripts/sync-music.mjs",
    "hls": "node scripts/build-hls.mjs",
    "salt": "node scripts/gen-salt.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "hls.js": "^1.7.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "typescript": "^5.7.3"
  }
}
